    "mdast-util-from-markdown": "^2.0.1",
    "natural-orderby": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.3.0",
    "react-pdf": "^10.4.1",
    "react-pdf-tailwind": "^3.0.0",
    "usehooks-ts": "^3.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.4.2",
