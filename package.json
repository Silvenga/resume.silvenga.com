{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@silvenga/resume",
  "private": true,
  "license": "MIT",
  "author": "Mark Lopez <m@silvenga.com>",
  "repository": "git@github.com:Silvenga/resume.silvenga.com",
  "type": "module",
  "scripts": {
    "sri-dist": "posthtml -u posthtml-sri --posthtml-sri.basePath=dist/ dist/**/*.html",
    "lint": "oxlint && tsc --noEmit",
    "fmt": "oxfmt",
    "start": "vite --port 9999",
    "preview": "pnpm build && vite preview --port 9999",
    "clean": "rimraf ./dist",
    "build": "pnpm clean && vite build && pnpm sri-dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.6.1",
    "mdast-util-from-markdown": "^2.0.3",
    "natural-orderby": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-pdf": "^10.4.1",
    "react-pdf-tailwind": "^3.0.0",
    "tailwind-merge": "3.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "posthtml-cli": "^0.10.0",
    "posthtml-sri": "^2.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
