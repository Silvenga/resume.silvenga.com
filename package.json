    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "events": "^3.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.4.47",
    "posthtml-cli": "^0.10.0",
    "posthtml-doctype": "^1.1.1",
    "posthtml-external-link": "^0.1.2",
    "posthtml-sri": "^1.2.1",
    "process": "^0.11.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
